{
  "name": "dsh-workspace-focus",
  "version": "0.1.0",
  "description": "工作区聚焦：把 DSH 侧边栏收窄到当前聚焦的工作区，并在会话头部提供聚焦入口",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "workspace",
    "focus"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qiansanyu/dsh-workspace-focus.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
